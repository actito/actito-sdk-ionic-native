{
  "name": "capacitor-actito-inbox",
  "version": "5.0.0-beta.2",
  "description": "Actito Inbox Capacitor plugin.",
  "author": "Actito <mobile@actito.com> (https://actito.com)",
  "license": "MIT",
  "homepage": "https://github.com/actito/actito-sdk-ionic-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actito/actito-sdk-ionic-native.git"
  },
  "bugs": {
    "url": "https://github.com/Actito/actito-sdk-ionic-native/issues"
  },
  "keywords": [
    "actito",
    "ionic-native",
    "capacitor",
    "ios",
    "android"
  ],
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "CapacitorActitoInbox.podspec",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "yarn clean && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "typescript": "tsc --noEmit",
    "verify": "yarn verify:android && yarn verify:ios && yarn verify:web",
    "verify:android": "cd android && ./gradlew clean build && cd ..",
    "verify:ios" : "xcodebuild -scheme CapacitorActitoInbox -destination generic/platform=iOS",
    "verify:web": "yarn build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "pack": "npm pack",
    "prepack": "yarn build; yarn docs:replace-symbolic-links",
    "postpack": "yarn docs:create-symbolic-links",
    "prepare": "yarn build",
    "docs:create-symbolic-links": "rm README.md CHANGELOG.md MIGRATION.md; ln -s ../../README.md ../../CHANGELOG.md ../../MIGRATION.md .",
    "docs:replace-symbolic-links": "rm README.md CHANGELOG.md MIGRATION.md; cp ../../README.md ../../CHANGELOG.md ../../MIGRATION.md ."
  },
  "peerDependencies": {
    "@capacitor/core": "3 - 7",
    "capacitor-actito": "5.0.0-beta.2"
  },
  "devDependencies": {
    "@capacitor/android": "^3.0.0",
    "@capacitor/core": "^3.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^3.0.0",
    "capacitor-actito": "5.0.0-beta.2",
    "rimraf": "^6.1.2",
    "rollup": "^2.79.2",
    "typescript": "^5.9.3"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
